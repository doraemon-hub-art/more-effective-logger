import { Button, LineEdit, ListView, HorizontalBox, VerticalBox, GroupBox, ComboBox } from "std-widgets.slint";

struct LogEntry {
    level: string,
    timestamp: string,
    file_line: string,
    message: string,
}

struct FilterRule {
    field: string,
    operator: string,
    value: string,
}

export component AppWindow inherits Window {
    title: "More Effective Logger";
    width: 1024px;
    height: 768px;
    default-font-size: 13px;

    // Callbacks
    callback connect-session(string, string, string);
    callback start-tail(string);
    callback stop-tail();
    callback clear-logs();
    callback execute-command(string);
    callback add-filter(string, string, string);
    callback remove-filter(int);

    // Properties
    in-out property <string> file-path: "/tmp/running.INFO";
    in-out property <bool> is-connected: false;
    in-out property <[LogEntry]> log-entries: [];
    in-out property <[FilterRule]> filter-rules: [];
    in-out property <[string]> terminal-output: [];
    in-out property <string> ssh-host: "192.168.1.98:22";
    in-out property <string> ssh-username: "root";
    in-out property <string> ssh-password: "";
    in-out property <string> session-status: "Disconnected";
    in-out property <int> current-page: 0;
    in-out property <bool> follow-log-bottom: false;
    in-out property <float> font-scale: 1.0;
    private property <length> nav-font-size: 15px * font-scale;
    private property <length> title-font-size: 18px * font-scale;
    private property <length> body-font-size: 13px * font-scale;
    private property <length> log-font-size: 12px * font-scale;
    private property <length> log-level-col-width: (self.width - 200px) * 0.08;
    private property <length> log-time-col-width: (self.width - 200px) * 0.24;
    private property <length> log-file-col-width: (self.width - 200px) * 0.2;

    focus-area := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control
                && (event.text == "+" || event.text == "=") {
                root.font-scale = min(root.font-scale + 0.1, 2.0);
                accept
            } else if event.modifiers.control && event.text == "-" {
                root.font-scale = max(root.font-scale - 0.1, 0.7);
                accept
            } else {
                reject
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 0px;

        // 左侧导航
        Rectangle {
            width: 150px;
            background: #1e1e2e;

            VerticalBox {
                padding: 10px;
                spacing: 5px;
                alignment: start;

                Text { text: "Menu"; font-size: root.nav-font-size; color: white; }

                Rectangle { height: 1px; background: #444; }

                Button {
                    text: "Logs";
                    clicked => { current-page = 0; }
                }
                Button {
                    text: "Session";
                    clicked => { current-page = 1; }
                }
                Button {
                    text: "Settings";
                    clicked => { current-page = 2; }
                }
                Button {
                    text: "Terminal";
                    clicked => { current-page = 3; }
                }
            }
        }

        // 主内容区
        Rectangle {
            background: #181825;
            width: parent.width - 150px;

            // Logs 页面
            if current-page == 0: VerticalBox {
                padding: 10px;
                spacing: 5px;

                // 顶部工具栏
                HorizontalBox {
                    spacing: 5px;
                    height: 35px;

                    Text { text: "File Path:"; color: white; vertical-alignment: center; }
                    LineEdit {
                        text <=> file-path;
                        placeholder-text: "/tmp/running.INFO";
                        font-size: root.body-font-size;
                    }
                    Button {
                        text: "Clear";
                        clicked => { clear-logs(); }
                    }
                    Button {
                        text: follow-log-bottom ? "Cancel Bottom" : "Bottom";
                        clicked => {
                            follow-log-bottom = !follow-log-bottom;
                        }
                    }
                    Button {
                        text: is-connected ? "Stop" : "Start";
                        clicked => {
                            if is-connected {
                                stop-tail();
                            } else {
                                start-tail(file-path);
                            }
                        }
                    }
                    Text {
                        text: is-connected ? "Connected" : "";
                        color: #50fa7b;
                        vertical-alignment: center;
                        font-size: root.body-font-size;
                    }
                }

                // 过滤器
                HorizontalBox {
                    spacing: 5px;
                    height: 35px;

                    Text { text: "Filter:"; color: white; vertical-alignment: center; }

                    filter-field := ComboBox {
                        model: ["Message", "Level", "FileLine", "Timestamp"];
                        current-value: "Message";
                    }
                    filter-op := ComboBox {
                        model: ["IncludeContains", "ExcludeContains", "IncludeRegex", "ExcludeRegex"];
                        current-value: "IncludeContains";
                    }
                    filter-value := LineEdit {
                        placeholder-text: "Input one condition and click Add";
                        font-size: root.body-font-size;
                    }
                    Button {
                        text: "Add";
                        clicked => {
                            add-filter(filter-field.current-value, filter-op.current-value, filter-value.text);
                            filter-value.text = "";
                        }
                    }
                }

                // 已添加的过滤规则
                Rectangle {
                    height: 100px;
                    background: #1e1e2e;
                    border-radius: 4px;

                    VerticalBox {
                        padding: 10px;
                        spacing: 5px;

                        Text { text: "Active Filters:"; color: white; font-size: root.body-font-size; }

                        ListView {
                            height: 70px;
                            for rule[index] in filter-rules: HorizontalBox {
                                spacing: 10px;
                                height: 25px;
                                padding: 2px;

                                Text { text: rule.field; color: #89b4fa; font-size: root.body-font-size; width: 80px; }
                                Text { text: rule.operator; color: #f5c2e7; font-size: root.body-font-size; width: 150px; }
                                Text { text: rule.value; color: #a6e3a1; font-size: root.body-font-size; width: 200px; }
                                Button {
                                    text: "Remove";
                                    width: 60px;
                                    height: 20px;
                                    clicked => { remove-filter(index); }
                                }
                            }
                        }
                    }
                }

                // 日志表格
                Rectangle {
                    background: #1e1e2e;
                    border-radius: 4px;
                    height: parent.height - 140px;

                    VerticalBox {
                        padding: 5px;
                        spacing: 0px;

                        // 表头
                        HorizontalBox {
                            height: 25px;
                            padding: 5px;
                            spacing: 10px;

                            Text { text: "Level"; color: #cdd6f4; font-weight: 700; width: root.log-level-col-width; font-size: root.body-font-size; }
                            Text { text: "Timestamp"; color: #cdd6f4; font-weight: 700; width: root.log-time-col-width; font-size: root.body-font-size; }
                            Text { text: "File:Line"; color: #cdd6f4; font-weight: 700; width: root.log-file-col-width; font-size: root.body-font-size; }
                            Text { text: "Message"; color: #cdd6f4; font-weight: 700; font-size: root.body-font-size; }
                        }

                        Rectangle { height: 1px; background: #444; }

                        // 日志列表
                        log_list := ListView {
                            viewport-y: root.follow-log-bottom ? self.visible-height - self.viewport-height : 0px;
                            for entry in log-entries: HorizontalBox {
                                height: 22px;
                                padding: 5px;
                                spacing: 10px;

                                Text { text: entry.level; color: #a6e3a1; width: root.log-level-col-width; font-size: root.log-font-size; }
                                Text { text: entry.timestamp; color: #cdd6f4; width: root.log-time-col-width; font-size: root.log-font-size; }
                                Text { text: entry.file_line; color: #89b4fa; width: root.log-file-col-width; font-size: root.log-font-size; }
                                Text { text: entry.message; color: #cdd6f4; font-size: root.log-font-size; }
                            }
                        }
                    }
                }
            }

            // Session 页面
            if current-page == 1: VerticalBox {
                padding: 20px;
                spacing: 10px;
                alignment: start;

                Text { text: "Session Settings"; font-size: root.title-font-size; color: white; }

                HorizontalBox {
                    spacing: 10px;
                    height: 35px;
                    Text { text: "Host:"; color: white; width: 80px; vertical-alignment: center; }
                    LineEdit { text <=> ssh-host; font-size: root.body-font-size; }
                }
                HorizontalBox {
                    spacing: 10px;
                    height: 35px;
                    Text { text: "Username:"; color: white; width: 80px; vertical-alignment: center; }
                    LineEdit { text <=> ssh-username; font-size: root.body-font-size; }
                }
                HorizontalBox {
                    spacing: 10px;
                    height: 35px;
                    Text { text: "Password:"; color: white; width: 80px; vertical-alignment: center; }
                    LineEdit { text <=> ssh-password; input-type: password; font-size: root.body-font-size; }
                }

                Button {
                    text: "Connect";
                    clicked => { connect-session(ssh-host, ssh-username, ssh-password); }
                }

                Text { text: session-status; color: #50fa7b; font-size: root.body-font-size; }
            }

            // Settings 页面
            if current-page == 2: VerticalBox {
                padding: 20px;
                spacing: 10px;
                alignment: start;

                Text { text: "Settings"; font-size: root.title-font-size; color: white; }
                Text { text: "Use Ctrl +/- to adjust font size."; color: #888; font-size: root.body-font-size; }
            }

            // Terminal 页面
            if current-page == 3: VerticalBox {
                padding: 10px;
                spacing: 5px;

                Text { text: "Terminal"; font-size: root.title-font-size; color: white; }

                ListView {
                    for line in terminal-output: Text {
                        text: line;
                        color: #cdd6f4;
                        font-size: root.log-font-size;
                    }
                }

                terminal-input := LineEdit {
                    placeholder-text: "Enter command and press Enter...";
                    font-size: root.body-font-size;
                    accepted(text) => {
                        execute-command(text);
                        self.text = "";
                    }
                }
            }
        }
        }
    }
}
