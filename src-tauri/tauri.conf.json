{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "melogger",
  "identifier": "com.melogger.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "More Effective Logger",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/doraemon-hub-art/more-effective-logger",
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "libssl3",
          "libc6 (>= 2.35)"
        ],
        "files": {
          "/usr/share/doc/melogger/copyright": "../LICENSE",
          "/usr/share/doc/melogger/third-party-notices.txt": "../target/release-assets/third-party-notices.txt"
        }
      }
    },
    "category": "DeveloperTool"
  }
}
